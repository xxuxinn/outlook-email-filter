# macOS
.DS_Store
.AppleDouble
.LSOverride

# Google Drive temp files
.tmp.drivedownload/
.tmp.driveupload/

# Claude Code — track project agents/launch config so they sync across devices;
# only the per-machine permission file stays local
.claude/settings.local.json

# VBA binary files (if accidentally created)
*.frx

# Outlook data files
*.pst
*.ost

# Python bytecode
__pycache__/
*.pyc

# Environment/secrets
.env
*.key

# Virtualenvs / test artifacts
.venv/
.pytest_cache/

# Session logs
claude-scheduled-resume.log

# Nimbalyst auto-generated plugin manifest (local tool state)
.claude/plugins/.nimbalyst-generated/
